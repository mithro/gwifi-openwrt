# Layered over fleet-image/base.config (shared managed feature set).
# kmod-batman-adv RE-ENABLED 2026-07-12: the "batman panics boot" bisect
# ran on the pre-707 kernel and judged death by network silence — which
# is exactly what the qca8k lookup-state rmw bug produces (host deaf,
# link up; batman's boot-time autoload plausibly shifted timing into the
# calibration window). On the patched kernel batman 2025.4 insmods
# cleanly at runtime (probed live on puck11). Boot-autoload validated on
# puck11 before fleet rollout.
# Remote kernel log/panic channel — no field serial on the fleet.
# Receiver: gwifi-netconsole.service on wisp :6666 (per-puck logs in
# /var/log/gale-netconsole/). Loaded late by /etc/init.d/gale-netconsole.
CONFIG_PACKAGE_kmod-netconsole=y
# alfred + batadv-vis: distribute each puck's local batman-adv view over bat0
# so ANY node can emit the whole-mesh alfred-vis JSON that OpenWISP's
# batman-adv Topology receiver (netdiff BatmanParser) parses. ALFRED_VIS is
# the sub-option that builds /usr/sbin/batadv-vis. See gwifi-topology-push.
CONFIG_PACKAGE_alfred=y
CONFIG_PACKAGE_ALFRED_VIS=y
# NOTE: 802.1q is built into the kernel (CONFIG_VLAN_8021Q=y) — there is no
# kmod-8021q package, so no line is needed for VLAN sub-interface support.
# lldpd: advertise each puck to the switch fabric via LLDP (system name +
# mgmt IP + port), so the Netgear switches list the connected puck as an
# LLDP neighbor instead of only a learned MAC. Config in files/etc/config/lldpd
# restricts it to the physical jacks (lan/wan); enabled by 99-gale-bootstrap.
CONFIG_PACKAGE_lldpd=y
# --- ChromeOS EC (cros_ec) in-band access to the gale EC ---
# The gale EC is an I2C slave to the AP at 0x1e on the 78b8000 bus (blsp1_i2c4
# = /dev/i2c-1), speaking cros_ec host-command protocol v3 (validated live
# 2026-07-18). The whole cros_ec driver family is built as MODULES and shipped
# via the kmod-cros-ec package below (package/kernel/linux/modules/cros-ec.mk,
# openwrt-patches/0004). The kernel symbols themselves are pinned =m/=n in the
# chromium subtarget kernel config (target/linux/ipq40xx/config-6.12,
# openwrt-patches/0003) — they can't be set from this .config because
# `make defconfig` strips unregistered CONFIG_KERNEL_*. The DT node
# google,cros-ec-i2c@1e (openwrt-patches/0002) makes cros_ec_i2c bind ->
# /dev/cros_ec (irq optional; host commands are synchronous). kmod-cros-ec
# AUTOLOADs the transport chain at boot.
CONFIG_PACKAGE_kmod-cros-ec=y
