#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# Periodically push the batman-adv mesh topology to OpenWISP (wisp) so the
# controller's receive-strategy Topology stays populated. Its links expire
# after ~330s, so a 60s cadence keeps the graph continuously fresh with room
# for a couple of missed pushes.
#
# Starts late (after network/mesh are up) and self-respawns via procd; the
# push script is a no-op until bat0 + batadv-vis exist, so an early start is
# harmless.
START=99
USE_PROCD=1

INTERVAL=60

start_service() {
	procd_open_instance
	# procd has no built-in interval; a respawning sleep-loop is the
	# idiomatic OpenWrt way to run a periodic userspace push.
	procd_set_param command /bin/sh -c \
		"while :; do /usr/sbin/gwifi-topology-push; sleep $INTERVAL; done"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
