#!/bin/sh
# 99-gale-bootstrap — first-boot network/mesh setup for gale auto-provisioning.
# Idempotent: uses fixed UCI section names so re-runs overwrite, not duplicate.
#
# Management (REVISED for the wisp netboot-install design D4/D7, 2026-07-12 —
# was tagged VLAN 5): the wifi VLAN (4) is UNTAGGED on the puck's switch
# port, so br-mgmt bridges BOTH wired ports raw (either may hold the cable;
# the netboot firmware and OpenWrt disagree on which physical port carries
# the label MAC) plus bat0.4 for mesh-side mgmt. DHCP from wisp
# (10.1.4.2); router/DNS = ten64 (10.1.4.1).
#
# Client VLANs stay tagged over the wired trunk + the mesh; APs attach later
# via OpenWISP (wifi-iface network=br-<name>).
VLANS="int=10 roam=20 iot=90 guest=99"
MGMT_BAT_VID=4

# --- batman-adv core (bat0) + the 802.11s hardif join ---
uci -q batch <<'EOF'
set network.bat0=interface
set network.bat0.proto='batadv'
set network.bat0.routing_algo='BATMAN_IV'
set network.bat0.bridge_loop_avoidance='1'
set network.bat0.distributed_arp_table='1'
set network.bat0.gw_mode='client'
set network.mesh_hardif=interface
set network.mesh_hardif.proto='batadv_hardif'
set network.mesh_hardif.master='bat0'
set network.mesh_hardif.mtu='1536'
EOF

# --- management bridge: default br-lan becomes br-mgmt ---
# Find the board-generated br-lan device section (anonymous; index varies).
i=0
brdev=""
while name=$(uci -q get "network.@device[$i].name"); do
	[ "$name" = "br-lan" ] && brdev="@device[$i]" && break
	i=$((i + 1))
done
# Field lesson (puck12, 2026-07-12): on the true first boot this script can
# run before the board network config exists — br-lan is absent, and a
# silent skip self-deletes the script with the job half done. Exit NONZERO
# instead: uci-defaults keeps the script and retries next boot until the
# board config is there.
if [ -z "$brdev" ]; then
	echo "gale-bootstrap: br-lan device not found (board config not" \
	     "generated yet?) — will retry next boot" >&2
	exit 1
fi
uci set "network.$brdev.name"='br-mgmt'
# lan is already a port; add the other wired port + mesh mgmt.
#
# NO STP — field finding (puck12, 2026-07-12): with stp='1' the puck's
# port went deaf ~10 min after every boot (link up, FDB populated, RX
# dead; the ipq40xx DSA driver is known to misprogram port STP states),
# while every STP-less image was stable. Tradeoff: a DOUBLE-cabled puck
# would loop the switch — the fleet is single-cabled; do not cable both
# ports.
uci -q del_list "network.$brdev.ports"='lan'
uci add_list "network.$brdev.ports"='lan'
uci -q del_list "network.$brdev.ports"='wan'
uci add_list "network.$brdev.ports"='wan'
uci -q del_list "network.$brdev.ports"="bat0.$MGMT_BAT_VID"
uci add_list "network.$brdev.ports"="bat0.$MGMT_BAT_VID"
uci -q delete "network.$brdev.stp"
# batman mgmt sub-iface (the tag exists only inside the mesh)
uci set network.bat_mgmt="device"
uci set network.bat_mgmt.type='8021q'
uci set network.bat_mgmt.ifname='bat0'
uci set network.bat_mgmt.vid="$MGMT_BAT_VID"
uci set network.bat_mgmt.name="bat0.$MGMT_BAT_VID"
# Default lan/wan/wan6 interfaces go away: both ports now live in br-mgmt.
uci -q delete network.lan
uci -q delete network.wan
uci -q delete network.wan6
uci set network.mgmt="interface"
uci set network.mgmt.device='br-mgmt'
uci set network.mgmt.proto='dhcp'
uci commit network

# No local DHCP server on the (removed) lan; wisp serves the mgmt VLAN.
uci -q set dhcp.lan.ignore='1'
# DNS rebind protection drops RFC1918 A answers from upstream — which is
# every internal record, including the OpenWISP controller (found live on
# puck12: agent starved with curl exit 6/7, AAAA-only resolution).
# Whitelist the site domain.
uci -q del_list dhcp.@dnsmasq[0].rebind_domain='mithis.com'
uci add_list dhcp.@dnsmasq[0].rebind_domain='mithis.com'
uci -q commit dhcp

# Remote syslog to wisp (UDP 6666, per-puck files in
# /var/log/gale-netconsole/ via gwifi-netconsole.service): the fleet has
# no field serial; logd forwards system AND kernel logs. (netconsole
# proper is a dead end here: DSA/ipqess lack usable netpoll TX —
# verified 2026-07-12; panics still escape, ramoops is the follow-up.)
uci set system.@system[0].log_ip='10.1.4.2'
uci set system.@system[0].log_port='6666'
uci set system.@system[0].log_proto='udp'
uci commit system

# Firewall: mgmt joins the trusted zone (zone 0 = 'lan' in the default
# config) so ssh + the openwisp agent work; the stale 'lan' member is
# removed with the interface it referenced.
uci -q del_list firewall.@zone[0].network='lan'
uci -q del_list firewall.@zone[0].network='mgmt'
uci add_list firewall.@zone[0].network='mgmt'
uci commit firewall

# --- client VLANs: tagged wired trunk + tagged mesh, L2-only bridges ---
for kv in $VLANS; do
	name=${kv%=*}; vid=${kv#*=}
	# tagged sub-iface on the wired DSA trunk port 'wan'
	uci set network.wan_$vid="device"
	uci set network.wan_$vid.type='8021q'
	uci set network.wan_$vid.ifname='wan'
	uci set network.wan_$vid.vid="$vid"
	uci set network.wan_$vid.name="wan.$vid"
	# tagged sub-iface on the batman mesh
	uci set network.bat_$vid="device"
	uci set network.bat_$vid.type='8021q'
	uci set network.bat_$vid.ifname='bat0'
	uci set network.bat_$vid.vid="$vid"
	uci set network.bat_$vid.name="bat0.$vid"
	# per-VLAN bridge: wired + mesh (APs auto-attach via wifi-iface network=)
	uci set network.br_$name="device"
	uci set network.br_$name.type='bridge'
	uci set network.br_$name.name="br-$name"
	uci -q delete network.br_$name.ports
	uci add_list network.br_$name.ports="wan.$vid"
	uci add_list network.br_$name.ports="bat0.$vid"
	# interface on the bridge
	uci set network.$name="interface"
	uci set network.$name.device="br-$name"
	uci set network.$name.proto='none'
done
uci commit network
exit 0
