# Radios only — the image ships NO wifi-ifaces (2026-07-22 simple-profile
# default): a freshly flashed puck comes up with just the wired uplink +
# mgmt DHCP, and the APs arrive via the OpenWISP 'gwifi-aps' template once
# the agent registers. The 802.11s mesh backhaul is NOT configured by
# default; /usr/sbin/gale-mesh-bootstrap adds it (with the batman network
# core) when a device is flipped to the mesh architecture.
#
# NOTE: after the agent's FIRST wireless apply, beacons may not start (the
# partial-reload bug, see gwifi memory 2026-07-22) — a plain `wifi` fixes.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/a000000.wifi'
	option channel '6'
	option band '2g'
	option htmode 'HT20'
	option disabled '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/a800000.wifi'
	option channel '36'
	option band '5g'
	option htmode 'VHT80'
	option disabled '0'
