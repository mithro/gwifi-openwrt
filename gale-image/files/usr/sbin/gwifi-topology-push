#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# gwifi-topology-push — emit the whole-mesh alfred-vis JSON and POST it to
# the OpenWISP batman-adv topology receiver on wisp.
#
# Each puck emits its OWN local vis view (its primary + direct-neighbour
# edges + client TT). alfred is meant to flood every node's view mesh-wide so
# any single `batadv-vis -f jsondoc` is the complete graph, but that cross-
# sync does not currently converge over batman (each node sees only itself —
# likely batman multicast/MLD optimisation dropping alfred's link-local
# multicast). This is fine: OpenWISP's receive strategy is ADDITIVE — netdiff
# unions the edges from all pushers and only expires a link absent from EVERY
# push for >expiration_time. So the full graph is assembled from the fleet's
# partial pushes (all pucks push on the same 60s cadence). netdiff's
# BatmanParser consumes this format verbatim (top-level "source_version" +
# "vis":[{primary,neighbors:[{neighbor,metric}],clients}...]).
# See docs/wisp-netboot-install-design.md (mesh topology reporting).

URL='__TOPOLOGY_RECEIVE_URL__'
BAT='bat0'
TMP='/tmp/gwifi-topology.json'
# stderr goes to a log, NEVER /dev/null — a silent push failure is invisible.
ERRLOG='/tmp/gwifi-topology.err'

[ -n "$URL" ] || { echo "gwifi-topology: no receive URL configured" >&2; exit 0; }
[ -x /usr/sbin/batadv-vis ] || { echo "gwifi-topology: batadv-vis missing" >&2; exit 0; }
[ -e "/sys/class/net/$BAT" ] || { echo "gwifi-topology: $BAT not present yet" >&2; exit 0; }

# batadv-vis writes the JSON document to stdout; keep its diagnostics in the
# log so a malformed/empty run leaves a trail instead of a corrupted body.
if ! /usr/sbin/batadv-vis -i "$BAT" -f jsondoc >"$TMP" 2>>"$ERRLOG"; then
	echo "gwifi-topology: batadv-vis failed (see $ERRLOG)" >&2
	exit 1
fi
[ -s "$TMP" ] || { echo "gwifi-topology: empty vis output (alfred not converged?)" >&2; exit 0; }

if uclient-fetch -q -O - --timeout=15 \
	--header='Content-Type: text/plain' \
	--post-file="$TMP" "$URL" >>"$ERRLOG" 2>&1; then
	echo "gwifi-topology: pushed $(wc -c <"$TMP") bytes"
else
	echo "gwifi-topology: POST failed (see $ERRLOG)" >&2
	exit 1
fi
