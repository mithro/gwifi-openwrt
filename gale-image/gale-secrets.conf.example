# gale-image/gale-secrets.conf.example — copy to gale-secrets.conf (untracked) and fill in.
# These are substituted into the overlay at build time; NEVER commit the filled file.
OPENWISP_SHARED_SECRET=""   # org "default" shared secret (OpenWISP admin -> Organizations -> config settings)
MESH_SAE_KEY=""             # WPA3-SAE key for the 802.11s backhaul; MUST match the OpenWISP gwifi-puck template's mesh key
MESH_ID="gwifi-mesh"        # 802.11s mesh id (fleet-wide; MUST match the OpenWISP template; safe to keep here)
OPENWISP_URL="https://wisp.welland.mithis.com"
# Full POST URL (incl. ?key=) of the OpenWISP batman-adv "receive" Topology
# the pucks push their mesh graph to. Get it from the Topology admin page
# (Network Topology -> Topologies -> the batman-adv/receive entry) or the
# object's uuid+key. Contains a secret key — keep this file untracked.
TOPOLOGY_RECEIVE_URL="https://wisp.welland.mithis.com/api/v1/network-topology/topology/<uuid>/receive/?key=<key>"
