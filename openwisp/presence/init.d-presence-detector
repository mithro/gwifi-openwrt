#!/bin/sh /etc/rc.common

START=90
STOP=1
USE_PROCD=1
NAME=presence-detector
PROG=/opt/presence-detector/presence-detector.py

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 "$PROG" -c /etc/presence-detector/settings.json
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_set_param term_timeout 300
	procd_close_instance
}

# Local changes vs upstream a81e6642ed86e53ffed691b91af9e661829ecd53: NAME, PROG path, explicit python3 + config path.
