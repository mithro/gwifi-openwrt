# OpenWISP runs Ansible against itself (the wisp VM), so the controller box
# provisions and later upgrades itself with no separate control node.
#
#   * inventory_hostname = wisp.monarto.mithis.com
#       -> used verbatim for the nginx server_name, the TLS cert CN, Django
#          ALLOWED_HOSTS and the /etc/hosts self-reference.
#       -> MUST be the FQDN, never a bare IP (postfix breaks on an IP, which
#          would turn some admin actions into HTTP 500s).
#   * ansible_connection=local
#       -> tasks run on this machine directly (fast, no SSH fan-out, no
#          ProxyJump fragility for the hundreds of connections a run makes).
#
# ONE host per file, on purpose.  With connection=local a second host listed
# here would be configured onto whichever box the run happens on, silently
# mis-configuring a site.  See D2 in
# docs/superpowers/specs/2026-08-02-wisp-monarto-design.md.
#
# NB when reaching this site from elsewhere: monarto is IPv6-direct-only.
# Its A record is a reverse proxy on a DIFFERENT machine, so `ssh -6` (D5).
# That does not affect this file — the playbook runs locally on the VM.
#
# Run as user `tim` (passwordless sudo); `become: true` in the playbook
# escalates per-task.

[openwisp2]
wisp.monarto.mithis.com ansible_connection=local
