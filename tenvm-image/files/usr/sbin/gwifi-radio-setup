#!/bin/sh
# gwifi-radio-setup — enable the host's passed-through Wi-Fi radio(s) and anchor the
# 802.11s mesh, DRIVER-AGNOSTIC: works for whatever PCIe card is passed through
# (ath9k/ath10k/ath11k/ath12k, mt76, rtw88/rtw89, ...). Bands are auto-detected by
# `wifi config`; the mesh anchors on a 5/6 GHz radio when one exists (else any radio).
# Client APs come from OpenWISP. No-op when no phy is present (image-first /
# pre-passthrough). Sourceable for tests via GWIFI_RADIO_SOURCED=1.
# See docs/ten64-vm-image-design.md §7.3.
set -u
LOG_TAG=gwifi-radio-setup

# ---- generic sysfs phy helpers (unit-tested in tests/tenvm/) ----------------
# Read GWIFI_RADIO_SYSFS live (not a top-level snapshot) so tests can repoint it.
# any_phy_present -> "1" if at least one phy exists under the sysfs root, else "".
any_phy_present() {
	_sysfs=${GWIFI_RADIO_SYSFS:-/sys/class/ieee80211}
	for _p in "$_sysfs"/phy*; do [ -e "$_p" ] && { echo 1; return 0; }; done
}
# bdf_of_phy PHY -> the PCI BDF (basename of the resolved device dir), e.g. 0000:00:02.0.
bdf_of_phy() {
	_sysfs=${GWIFI_RADIO_SYSFS:-/sys/class/ieee80211}
	_t=$(readlink -f "$_sysfs/$1/device") || return 0
	echo "${_t##*/}"
}
# wifi_devices -> the uci wifi-device section names, one per line.
wifi_devices() {
	uci show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device/\1/p'
}

main() {
	if [ -z "$(any_phy_present)" ]; then
		logger -t "$LOG_TAG" "no Wi-Fi phys present; skipping radio setup"
		return 0
	fi
	# Diagnostic: log each present phy's driver + BDF (helps debug passthrough).
	_sysfs=${GWIFI_RADIO_SYSFS:-/sys/class/ieee80211}
	for _p in "$_sysfs"/phy*; do
		[ -e "$_p/device" ] || continue
		_pn=${_p##*/}
		if [ -e "$_p/device/driver" ]; then _drv=$(readlink "$_p/device/driver"); _drv=${_drv##*/}; else _drv="(unbound)"; fi
		logger -t "$LOG_TAG" "present: $_pn driver=$_drv bdf=$(bdf_of_phy "$_pn")"
	done
	# Generate radioN sections (+ correct PCI paths + auto-detected band) for whatever
	# card(s) are present. wifi config also emits a disabled default AP per radio
	# (mode=ap network=lan ssid=OpenWrt); harmless stubs that OpenWISP overwrites.
	wifi config
	_mesh=""        # preferred 5/6 GHz radio to anchor the mesh
	_first=""       # fallback: first radio of any band
	for _r in $(wifi_devices); do
		[ -n "$_first" ] || _first=$_r
		uci set "wireless.$_r.channel=auto"
		uci set "wireless.$_r.disabled=0"
		_band=$(uci -q get "wireless.$_r.band")
		case "$_band" in
			6g|5g) [ -n "$_mesh" ] || _mesh=$_r ;;
		esac
		logger -t "$LOG_TAG" "enabled $_r (band=${_band:-?})"
	done
	[ -n "$_mesh" ] || _mesh=$_first   # no 5/6 GHz radio -> anchor mesh on whatever exists
	if [ -n "$_mesh" ]; then
		uci set wireless.mesh0.device="$_mesh"
		logger -t "$LOG_TAG" "mesh0 -> $_mesh"
	fi
	uci commit wireless
	wifi reload
}

case "${GWIFI_RADIO_SOURCED:-}" in
	1) : ;;            # sourced (tests) — do not run
	*) main "$@" ;;
esac
